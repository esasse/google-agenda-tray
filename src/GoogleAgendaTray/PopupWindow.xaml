<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgendaTray.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgendaTray"
    Title="Agenda">

    <Grid x:Name="Root" Padding="16,12,10,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header: what day, how much of it is left -->
        <Grid Height="52" ColumnSpacing="12" Margin="0,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="HeaderIcon" Glyph="&#xE787;" FontSize="26" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Today" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="DateText" VerticalAlignment="Bottom" Margin="0,0,0,3"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="MetaText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Column="2" Width="36" Height="36" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Refresh (R)" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <ProgressRing x:Name="Spinner" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Visibility="Collapsed" Margin="0,0,6,0"
                   Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />

        <Grid x:Name="Body" Grid.Row="2">
            <ListView x:Name="EventsList" SelectionMode="Single" IsItemClickEnabled="True"
                      ItemClick="EventsList_ItemClick" Padding="0,0,0,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="6,0,6,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:EventItem">
                        <Grid Height="54" ColumnSpacing="10" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Rectangle Width="4" Height="34" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                       Fill="{x:Bind StripeBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind StartText}" FontSize="13"
                                           Foreground="{x:Bind TimeBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind EndText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                                           TextDecorations="{x:Bind TitleDecorations}" />
                                <TextBlock Text="{x:Bind Meta}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{x:Bind Relative, Mode=OneWay}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{x:Bind RelativeBrush, Mode=OneWay}" />

                            <Button Grid.Column="4" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                    Visibility="{x:Bind JoinVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind JoinTooltip}" Click="Join_Click">
                                <FontIcon Glyph="&#xE714;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

            <!-- first run: no OAuth client yet, or no account -->
            <StackPanel x:Name="SetupPanel" Spacing="10" Margin="0,4,6,0" Visibility="Collapsed">
                <TextBlock x:Name="SetupTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="SetupBody" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SetupPrimary" Style="{StaticResource AccentButtonStyle}" Click="SetupPrimary_Click" />
                    <Button x:Name="SetupSecondary" Click="SetupSecondary_Click" />
                </StackPanel>
                <HyperlinkButton x:Name="SetupLink" Padding="0" Click="SetupLink_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="3" Margin="0,0,6,0" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Window>
