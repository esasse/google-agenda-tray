<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgendaTray.MonthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgendaTray"
    Title="Agenda">

    <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar: the content extends into it, this is the drag area -->
        <Grid x:Name="TitleBar" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Agenda" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- header: which month, how to move between them -->
        <Grid Grid.Row="1" Padding="20,6,20,10" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="TodayButton" Content="Today" Click="Today_Click" Margin="0,0,6,0"
                    ToolTipService.ToolTip="Today (T)" />
            <Button Grid.Column="1" Width="34" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Previous month (Page Up)" Click="Prev_Click">
                <FontIcon Glyph="&#xE76B;" FontSize="13" />
            </Button>
            <Button Grid.Column="2" Width="34" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Next month (Page Down)" Click="Next_Click">
                <FontIcon Glyph="&#xE76C;" FontSize="13" />
            </Button>
            <TextBlock x:Name="MonthTitle" Grid.Column="3" Margin="10,0,0,2" VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <Grid Grid.Column="5" Width="36" Height="36" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Refresh (R)" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <ProgressRing x:Name="Spinner" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="20,0,20,8" Visibility="Collapsed"
                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"
                   TextTrimming="CharacterEllipsis" />

        <Grid x:Name="Body" Grid.Row="3" Padding="20,0,20,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PanelColumn" Width="340" />
            </Grid.ColumnDefinitions>

            <!-- the month -->
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="WeekdayHeader" />
                <!-- focusable host: the arrow keys need something inside the window to
                     have the focus, and a click on a day must not drop it -->
                <ContentControl x:Name="GridHost" Grid.Row="1" IsTabStop="True" UseSystemFocusVisuals="False"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Border BorderThickness="1,1,0,0" CornerRadius="6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid x:Name="MonthGrid" SizeChanged="MonthGrid_SizeChanged" />
                    </Border>
                </ContentControl>
            </Grid>

            <!-- the selected day, in full -->
            <Border x:Name="DayPanel" Grid.Column="1" CornerRadius="6" BorderThickness="1" Padding="0,12,0,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Padding="16,0,16,4">
                        <TextBlock x:Name="DayTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="DayMeta" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView x:Name="DayList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="DayList_ItemClick" Padding="4,0,4,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="8,0,6,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EventItem">
                                <Grid Padding="0,7,0,7" ColumnSpacing="10" Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind PanelTooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{x:Bind StripeBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SpanText}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" TextDecorations="{x:Bind TitleDecorations}" />
                                        <TextBlock Text="{x:Bind Meta}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                            Visibility="{x:Bind TodayJoinVisibility, Mode=OneWay}" IsTabStop="False"
                                            ToolTipService.ToolTip="{x:Bind JoinTooltip}" Click="Join_Click">
                                        <FontIcon Glyph="&#xE714;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="DayEmpty" Grid.Row="1" Margin="16,8,16,0" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="4" Margin="20,8,20,10" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Window>
