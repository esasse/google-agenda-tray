<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AgendaTray.ReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AgendaTray"
    Title="Coming up">

    <Grid x:Name="Root" Padding="16,10,8,14" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Height="32" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE787;" FontSize="14" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Coming up" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" Width="32" Height="32" Padding="0" Background="Transparent"
                    BorderThickness="0" ToolTipService.ToolTip="Dismiss all" Click="DismissAll_Click">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <!-- The card is capped at the work area's height: past that, the rest scrolls. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:EventItem">
                        <Grid ColumnSpacing="12" Padding="0,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{x:Bind StripeBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind WhenText, Mode=OneWay}" FontSize="12"
                                           Foreground="{x:Bind RelativeBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Meta}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="Join_Click"
                                            ToolTipService.ToolTip="{x:Bind ActionTooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind ActionGlyph}" FontSize="14" />
                                            <TextBlock Text="{x:Bind ActionLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Dismiss" Click="Dismiss_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
